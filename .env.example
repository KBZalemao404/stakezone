# ============================================
# StakeZone - Configuração de APIs
# ============================================
# Copie este arquivo para .env e preencha as chaves
# Para obter chaves gratuitas, acesse os links abaixo

# The Odds API - Odds reais de casas de apostas
# Cadastro gratuito: https://the-odds-api.com/#/get-access
# Free tier: 500 créditos/mês
VITE_ODDS_API_KEY=

# API-Football - Placares ao vivo, classificações, estatísticas
# Cadastro gratuito: https://www.api-football.com/register
# Free tier: 100 requests/dia
VITE_FOOTBALL_API_KEY=
